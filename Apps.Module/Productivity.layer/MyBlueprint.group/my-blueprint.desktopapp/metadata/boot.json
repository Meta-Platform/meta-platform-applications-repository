{
  "params": ["port", "serverName", "serverManagerUrl", "isWatch", "MB_DB_FILE_PATH"],
  "services": [{ "namespace": "@@/server-service", "dependency": "@/server-manager.service/services/HTTPServerService", "params": { "name": "{{serverName}}", "port": "{{port}}" } }],
  "endpoints": [
    { "dependency": "@/server-manager.webservice/endpoint-group", "bound-params": { "serverServiceForController": "@@/server-service", "serverService": "@@/server-service" } },
    { "dependency": "@/my-blueprint.webservice/endpoint-group", "params": { "MB_DB_FILE_PATH": "{{MB_DB_FILE_PATH}}" }, "bound-params": { "serverService": "@@/server-service", "blueprintStoreLib": "@/blueprint-store.lib" } },
    { "dependency": "@/my-blueprint.webgui/endpoint-group", "params": { "serverManagerUrl": "{{serverManagerUrl}}", "serverName": "{{serverName}}", "isWatch": "{{isWatch}}" }, "bound-params": { "serverService": "@@/server-service", "iComponents": "@/i-components.uilib" } }
  ],
  "windows": [{ "title": "My Blueprint", "width": 1360, "height": 860, "url": "http://localhost:{{port}}/", "dependency": "@/my-blueprint.webgui", "params": { "serverName": "{{serverName}}" }, "bound-params": { "serverService": "@@/server-service" } }]
}
