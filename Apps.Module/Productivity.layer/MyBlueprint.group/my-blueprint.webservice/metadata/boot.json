  "endpoints": [{ "dependency": "@/server-manager.webservice/endpoint-group", "bound-params": { "serverServiceForController": "@@/server-service", "serverService": "@@/server-service" } }, { "dependency": "@//endpoint-group", "params": { "MB_DB_FILE_PATH": "{{MB_DB_FILE_PATH}}" }, "bound-params": { "blueprintStoreLib": "@/blueprint-store.lib" } }]
}
