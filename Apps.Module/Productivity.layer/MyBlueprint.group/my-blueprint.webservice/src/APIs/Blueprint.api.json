    { "summary": "UpdateItem", "method": "PATCH", "path": "/blueprint/items/:id", "parameters": [{ "name":"id", "in":"path", "type":"string", "required":true }, { "name":"title", "in":"body", "type":"string" }, { "name":"body", "in":"body", "type":"string" }, { "name":"type", "in":"body", "type":"string" }, { "name":"status", "in":"body", "type":"string" }, { "name":"priority", "in":"body", "type":"string" }, { "name":"tags", "in":"body", "type":"array" }] },
