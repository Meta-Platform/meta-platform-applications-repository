      "@instance-components": ["../../../InstanceManager.layer/instance-manager.icomponents/src"],
      "@instance-components/*": ["../../../InstanceManager.layer/instance-manager.icomponents/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
