{
  "params": ["serverName"],
  "windows": [{
    "title": "Application Repository · UI Catalog",
    "width": 1360,
    "height": 860,
    "dependency": "@/ui-catalog.webgui",
    "params": { "serverName": "{{serverName}}" },
    "bound-params": {
