{
    "name": "Networks",
    "endpoints": [
        {
            "summary": "ListNetworks",
            "method": "POST",
            "path": "/networks/list",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                }
            ]
        },
        {
            "summary": "InspectNetwork",
            "method": "POST",
            "path": "/networks/inspect",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "networkIdOrName",
                    "type": "string",
                    "required": true
                }
            ]
        },
        {
            "summary": "CreateNetwork",
            "method": "POST",
            "path": "/networks/create",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "options",
                    "type": "json",
                    "required": true
                }
            ]
        },
        {
            "summary": "RemoveNetwork",
            "method": "POST",
            "path": "/networks/remove",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "networkIdOrName",
                    "type": "string",
                    "required": true
                }
            ]
        },
        {
            "summary": "ConnectContainerToNetwork",
            "method": "POST",
            "path": "/networks/connect",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "networkIdOrName",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "containerIdOrName",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "aliases",
                    "type": "json",
                    "required": false
                }
            ]
        },
        {
            "summary": "DisconnectContainerFromNetwork",
            "method": "POST",
            "path": "/networks/disconnect",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "networkIdOrName",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "containerIdOrName",
                    "type": "string",
                    "required": true
                }
            ]
        },
        {
            "summary": "GetNetworkUsage",
            "method": "POST",
            "path": "/networks/usage",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "networkIdOrName",
                    "type": "string",
                    "required": true
                }
            ]
        },
        {
            "summary": "PruneNetworks",
            "method": "POST",
            "path": "/networks/prune",
            "parameters": [
                {
                    "in": "body",
                    "name": "connectionId",
                    "type": "string",
                    "required": true
                },
                {
                    "in": "body",
                    "name": "filters",
                    "type": "json",
                    "required": false
                }
            ]
        }
    ]
}