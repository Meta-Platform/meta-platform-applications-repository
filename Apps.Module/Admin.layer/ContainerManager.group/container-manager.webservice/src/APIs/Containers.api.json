{
    "name": "Containers",
    "endpoints": [
        {
            "summary": "ListContainers",
            "method": "POST",
            "path": "/containers/list",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true }
            ]
        },
        {
            "summary": "InspectContainer",
            "method": "POST",
            "path": "/containers/inspect",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "GetContainerLogHistory",
            "method": "POST",
            "path": "/containers/logs",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "StartContainer",
            "method": "POST",
            "path": "/containers/start",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "StopContainer",
            "method": "POST",
            "path": "/containers/stop",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "RestartContainer",
            "method": "POST",
            "path": "/containers/restart",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "KillContainer",
            "method": "POST",
            "path": "/containers/kill",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "RemoveContainer",
            "method": "POST",
            "path": "/containers/remove",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "CreateContainer",
            "method": "POST",
            "path": "/containers/create",
            "parameters": [
                { "in": "body", "name": "connectionId", "type": "string", "required": true },
                { "in": "body", "name": "options", "type": "json", "required": true }
            ]
        },
        {
            "summary": "LogStream",
            "method": "WS",
            "path": "/containers/log-stream/:connectionId/:containerIdOrName",
            "parameters": [
                { "in": "path", "name": "connectionId", "type": "string", "required": true },
                { "in": "path", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "StatsStream",
            "method": "WS",
            "path": "/containers/stats-stream/:connectionId/:containerIdOrName",
            "parameters": [
                { "in": "path", "name": "connectionId", "type": "string", "required": true },
                { "in": "path", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        },
        {
            "summary": "ExecSession",
            "method": "WS",
            "path": "/containers/exec/:connectionId/:containerIdOrName",
            "parameters": [
                { "in": "path", "name": "connectionId", "type": "string", "required": true },
                { "in": "path", "name": "containerIdOrName", "type": "string", "required": true }
            ]
        }
    ]
}
